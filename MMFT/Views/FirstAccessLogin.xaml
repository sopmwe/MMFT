<Window x:Class="MMFT.Views.FirstAccessLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MMFT.Views"
      mc:Ignorable="d" 
      Height="700" Width="400"
      Title="FirstAccessLogin">
    <StackPanel Background="#525252">
        <Grid Margin="30, 20, 30, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="MMFT" FontSize="40" Margin="0, 0, 0, 0" Foreground="#e6e6fa"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Image Source="/MMFT;component/Resources/logo.png" Height="50" Width="50" Grid.Column="1" Margin="10, 20, 30, 0"/>
        </Grid>
        <Label Content="Mad Messenger File Transporter" FontSize="20" Margin="30, 0, 30, 0" Foreground="#e6e6fa"/>
        <Label Content="Willkommen bei Mad Messenger File Transporter," FontSize="15" Margin="30, 10, 30, 0" Foreground="#e6e6fa" Height="29" Width="341"/>
        <Label Content="bitte legen Sie ein Profil an!" FontSize="15" Margin="30, 0, 30, 0" Foreground="#e6e6fa" Height="32" Width="341"/>
        
        <Label Content="Nutzernamen einstellen:" FontSize="15" Margin="30, 10, 30, 0" Foreground="#e6e6fa" Height="32" Width="341"/>
        <TextBox Name="NutzernameTB" Margin="30,0,30,0"/>
        
        <Label Content="Passwort festlegen:" FontSize="15" Margin="30, 10, 30, 0" Foreground="#e6e6fa" Height="32" Width="341"/>
        <TextBox Name="PasswortEinsTB" Margin="30,0,30,0"/>
        
        <Label Content="Passwort wiederholen:" FontSize="15" Margin="30, 10, 30, 0" Foreground="#e6e6fa" Height="32" Width="341"/>
        <TextBox Name="PasswortZweiTB" Margin="30,0,30,0"/>
        
        <Label Content="Profilbild auswählen:" FontSize="15" Margin="30, 10, 30, 0" Foreground="#e6e6fa" Height="32" Width="341"/>
        <Grid Margin="30,0,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="P_Bild.png" Grid.Column="0" Height="100" Width="100" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Name="BtnEinfügen" Content="einfügen" Width="150" Margin="0,0,0,10"/>
                <Button Name="BtnLöschen" Content="löschen" Width="150" />
            </StackPanel>
        </Grid>
        <Label Content="{Binding Fehlermeldung}" FontSize="15" Margin="30,0,30,10" Foreground="red"/>
        <Button Name="BtnFirstAccessLogin" Content="Login" FontSize="20" Width="100" Height="40" Margin="30, 30, 30, 0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
