<Window x:Class="MMFT.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MMFT.Views"
        mc:Ignorable="d"
        Title="Login" Height="500" Width="400">
    <StackPanel Background="#525252">
        <Grid Margin="30, 20, 30, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="MMFT" FontSize="40" Margin="0, 0, 0, 0" Foreground="#e6e6fa"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Image Source="/MMFT;component/Resources/logo.png" Height="50" Width="50" Grid.Column="1" Margin="10, 20, 30, 0"/>
        </Grid>
        <Label Content="Mad Messenger File Transporter" FontSize="20" Margin="30, 0, 30, 0" Foreground="#e6e6fa"/>
        <Label Content="Willkommen zurück," FontSize="30" Margin="30, 20, 30, 0" Foreground="#e6e6fa"/>
        <TextBlock Text="{Binding Nutzername}" FontSize="30" Margin="30, 0, 30, 10" Foreground="#e6e6fa"/>
        <Label Content="Passwort eingeben:" FontSize="20" Margin="30,10" Foreground="#e6e6fa"/>
        <Grid Margin="30,0,30,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="PasswortTB" Height="30" Grid.Column="0" VerticalContentAlignment="Center"/>
            <Button Name="btnPasswortAnzeigen" Height="30" Width="30" Grid.Column="1" Margin="0,0,0,0" Background="#eee9e9">
                <Image Source="/Ressourcen/Auge.png" Stretch="Uniform" Height="25" Width="25"/>
            </Button>
        </Grid>
        <Label Content="{Binding Fehlermeldung}" FontSize="15" Margin="30,0,30,10" Foreground="red"/>
        <Button Name="BtnLogin" Click="BtnLogin_Click" Content="Login" FontSize="20" Width="100" Height="40" Margin="30, 30, 30, 0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
